# Firebase Web API key.
# Firebase Console: Project settings > General > Your apps > Web app > SDK setup and configuration > apiKey.
NEXT_PUBLIC_FIREBASE_API_KEY=

# Firebase Auth domain.
# Firebase Console: Project settings > General > Your apps > Web app > SDK setup and configuration > authDomain.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Firebase project ID used by Authentication and Firestore.
# Firebase Console: Project settings > General > Project ID.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Storage bucket value from the web app configuration.
# Firebase Console: Project settings > General > Your apps > Web app > SDK setup and configuration > storageBucket.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase messaging sender ID from the web app configuration.
# Firebase Console: Project settings > General > Your apps > Web app > SDK setup and configuration > messagingSenderId.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase web app ID.
# Firebase Console: Project settings > General > Your apps > Web app > SDK setup and configuration > appId.
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare account ID that owns the R2 bucket.
# Cloudflare Dashboard: Account home > right sidebar or Workers & Pages > Overview > Account ID.
R2_ACCOUNT_ID=

# Cloudflare R2 access key ID for an API token with bucket access.
# Cloudflare Dashboard: R2 Object Storage > Manage R2 API tokens > Create API token.
R2_ACCESS_KEY_ID=

# Cloudflare R2 secret access key shown once when the R2 API token is created.
# Cloudflare Dashboard: R2 Object Storage > Manage R2 API tokens > Create API token.
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 bucket name used for uploaded booking documents.
# Cloudflare Dashboard: R2 Object Storage > Buckets > select or create bucket.
R2_BUCKET_NAME=

# Public/custom domain URL for reading public R2 assets, if enabled.
# Cloudflare Dashboard: R2 Object Storage > Bucket > Settings > Public access or Custom domains.
R2_PUBLIC_URL=
